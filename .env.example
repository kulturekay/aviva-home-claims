# storm-review environment.
# Copy to .env and fill in. See the command-to-key table below.
#
#   command            keys required
#   -----------------  --------------------------------------------------
#   npm run demo       ANTHROPIC_API_KEY        (fires the hero case live)
#   npm run serve      ANTHROPIC_API_KEY        (UI; live runs need the key)
#   npm run dev        ANTHROPIC_API_KEY        (Mastra Studio)
#   npm run evals      ANTHROPIC_API_KEY + JUDGE_API_KEY (judge is optional:
#                      without it the deterministic scorers still run and the
#                      LLM-judge line prints "skipped (no judge key)")
#   npm run doctor     none (checks node version + which keys are present)
#
# The cached golden run (golden/caseA.json) renders in the UI with ZERO keys,
# so the hero demo never depends on a live model call.

# Agent + verdict model (kept in the Anthropic family so dev/serve need one key).
ANTHROPIC_API_KEY=

# Model IDs are Mastra provider/model strings. Confirm these against the
# Anthropic account in use before a live run - the exact suffix moves over time.
AGENT_MODEL=anthropic/claude-sonnet-4-5

# Eval judge, deliberately a DIFFERENT model family from the agent.
# Optional: evals degrade gracefully without it.
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-4.1-mini

# UI server port (default 8787 if unset).
PORT=8787
