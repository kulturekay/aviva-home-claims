{
  "name": "storm-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Second-line reviewer for UK home-insurance storm-claim declines. Interview demo.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "mastra dev",
    "serve": "tsx src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "evals": "tsx src/mastra/evals/run.ts",
    "doctor": "tsx scripts/doctor.ts",
    "golden": "tsx scripts/record-golden.ts",
    "spike:suspend": "tsx scripts/spike/suspend.ts",
    "spike:resume": "tsx scripts/spike/resume.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@mastra/core": "1.67.0",
    "@mastra/evals": "1.10.2",
    "@mastra/libsql": "1.23.0",
    "@mastra/loggers": "1.3.2",
    "@mastra/observability": "1.17.8",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "mastra": "1.30.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
